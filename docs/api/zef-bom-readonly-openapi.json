    "/api/costing/breakdown": {
      "get": {
        "tags": [
          "bom"
        ],
        "summary": "Costing Breakdown",
        "description": "Per-part cost & weight contributions within ONE top-level BOM \u2014 for the treemaps.\n\nEach leaf's effective quantity (qty multiplied along every path) \u00d7 its decided unit\ncost / weight. Returns the parts sorted by cost, plus the cost-vs-volume curve for\nthis BOM only (not the whole plant).",
        "operationId": "costing_breakdown_api_costing_breakdown_get",
        "parameters": [
          {
            "name": "root",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Root"
            }
          },
          {
            "name": "volume",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Volume"
            }
          },
          {
            "name": "authorization",
            "in": "header",
