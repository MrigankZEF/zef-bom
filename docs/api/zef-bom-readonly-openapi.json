    "/api/flat": {
      "get": {
        "tags": [
          "bom"
        ],
        "summary": "Get Flat",
        "description": "A BOM flattened to one level: every descendant once, with the count the plant needs.\n\nThe nested tree answers \"what is this made of\"; this answers \"how many of that part do\nwe buy\". Rows come from the same graph as the tree and the treemaps, so the numbers\ncannot drift apart.\n\nRows cover what is *inside* the root, so the root's own assembly labour is not one of\nthem \u2014 it comes back as `own_assembly_cost` instead. Leaf rows + assembly rows +\nown_assembly_cost = `cost`.",
        "operationId": "get_flat_api_flat_get",
        "parameters": [
          {
            "name": "root",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "BOM root to flatten; omitted = all top-level BOMs",
              "title": "Root"
            },
            "description": "BOM root to flatten; omitted = all top-level BOMs"
          },
          {
            "name": "volume",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Volume"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
