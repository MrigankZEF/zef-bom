# ─── ZEF BOM backend configuration ───────────────────────────────────────────
# Copy to `.env` and fill in. Never commit the real `.env`.

# Database connection.
# DEV default (no value needed): a local SQLite file — sqlite:///./zef_bom.dev.db
# LATER, switch to managed Postgres by uncommenting and filling this in
# (SQLAlchemy + psycopg v3 driver form). The same migration runs on both.
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Supabase: "Connection string" → "URI" from Project Settings → Database,
#           with the scheme changed to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/zef_bom

# CORS — comma-separated origins allowed to call the API (the Vite dev server, the deployed frontend).
CORS_ORIGINS=http://localhost:5173

# ─── Google Drive (attachments: folder-per-part) ─────────────────────────────
# Service-account JSON key path (see the setup guide). Blank = Drive disabled.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# The Drive folder ID of "ZEF BOM Attachments" (from the folder URL). Blank = Drive disabled.
DRIVE_ATTACHMENTS_ROOT_ID=

# ─── Auth: Sign in with Google ───────────────────────────────────────────────
# The OAuth Web client ID (…apps.googleusercontent.com). Backend verifies ID tokens against it.
GOOGLE_OAUTH_CLIENT_ID=
AUTH_DISABLED=true
